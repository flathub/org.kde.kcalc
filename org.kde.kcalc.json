{
    "id": "org.kde.kcalc",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kcalc",
    "rename-icon": "accessories-calculator",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland"
    ],
    "cleanup": [
        "/share/doc",
        "/share/info",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "mpc",
            "cleanup": [
                "/include",
                "/lib/pkgconfig",
                "/share/doc/mpc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ftp.gnu.org/gnu/mpc/mpc-1.4.1.tar.xz",
                    "sha256": "91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 1667,
                        "stable-only": true,
                        "url-template": "https://ftp.gnu.org/gnu/mpc/mpc-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kcalc",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DINSTALL_ICONS=ON",
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.1/src/kcalc-26.08.1.tar.xz",
                    "sha256": "24d7b07dcac6e248354e8a4032cc91340f4ca2333f83964808adfa44b4bae096",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/kcalc-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
